        "jsonBody": "={{ JSON.stringify({ model: \"gpt-4o-mini\", messages: [ { role: \"system\", content: \"You are a friendly sales assistant for NextWave AI, an AI automation agency. The user has shown sales interest via WhatsApp. Reply in 2-3 short sentences, be warm and conversational (this is WhatsApp, not email), and invite them to share more about their business need or offer to book a short call. Do not use markdown formatting.\" }, { role: \"user\", content: $('Extract Message').item.json.text } ], temperature: 0.5 }) }}",
        "options": {}
      },
      "id": "http-generate-sales-reply",
      "name": "Generate Sales Reply",
