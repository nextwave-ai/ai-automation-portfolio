            "message_id": "={{ $json.message_id }}",
            "direction": "={{ $json.direction }}"
          }
        },
        "options": {}
      },
      "id": "sheets-log-inbound",
      "name": "Log Inbound Message",
      "type": "n8n-nodes-base.googleSheets",
      "typeVersion": 4.5,
      "position": [1100, 400]
    },
    {
      "parameters": {
        "method": "POST",
        "url": "https://api.openai.com/v1/chat/completions",
        "authentication": "predefinedCredentialType",
        "nodeCredentialType": "openAiApi",
        "sendBody": true,
        "specifyBody": "json",
        "jsonBody": "={{ JSON.stringify({ model: \"gpt-4o-mini\", messages: [ { role: \"system\", content: \"Classify the user's WhatsApp message into exactly one intent: sales (pricing, buying, demos, general interest in the product/service) or support (questions about existing policies, how something works, troubleshooting, account issues). Respond ONLY with valid JSON, no markdown, no code fences: {\\\"intent\\\": \\\"sales or support\\\"}\" }, { role: \"user\", content: $('Extract Message').item.json.text } ], temperature: 0 }) }}",
        "options": {}
      },
      "id": "http-classify-intent",
      "name": "Classify Intent",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [1320, 400]
    },
    {
      "parameters": {
        "jsCode": "let raw = $json.choices[0].message.content;\nraw = raw.replace(/```json|```/g, '').trim();\nlet parsed;\ntry {\n  parsed = JSON.parse(raw);\n} catch (e) {\n  parsed = { intent: 'support' };\n}\nif (!['sales', 'support'].includes(parsed.intent)) {\n  parsed.intent = 'support';\n}\nreturn [{ json: { intent: parsed.intent } }];"
      },
      "id": "code-parse-intent",
      "name": "Parse Intent",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [1540, 400]
    },
    {
      "parameters": {
        "conditions": {
          "options": {"caseSensitive": true, "leftValue": "", "typeValidation": "strict"},
          "conditions": [
            {"id":"c1","leftValue":"={{ $json.intent }}","rightValue":"support","operator":{"type":"string","operation":"equals"}}
          ],
          "combinator": "and"
        },
        "options": {}
      },
      "id": "if-intent-router",
      "name": "Intent Router",
      "type": "n8n-nodes-base.if",
      "typeVersion": 2.2,
      "position": [1760, 400]
