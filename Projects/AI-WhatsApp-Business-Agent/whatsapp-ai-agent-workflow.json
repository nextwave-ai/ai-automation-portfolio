{
  "name": "WhatsApp - AI Sales & Support Agent",
  "nodes": [
    {
      "parameters": {
        "httpMethod": "GET",
        "path": "whatsapp-webhook",
        "responseMode": "responseNode",
        "options": {}
      },
      "id": "webhook-verify-get",
      "name": "Webhook - Verify (GET)",
      "type": "n8n-nodes-base.webhook",
      "typeVersion": 2,
      "position": [220, 160],
      "webhookId": "whatsapp-webhook-verify"
    },
    {
      "parameters": {
        "jsCode": "const VERIFY_TOKEN = 'nextwave-verify-2026';\n\nconst query = $input.first().json.query || {};\nconst mode = query['hub.mode'];\nconst token = query['hub.verify_token'];\nconst challenge = query['hub.challenge'];\n\nconst isValid = mode === 'subscribe' && token === VERIFY_TOKEN;\n\nreturn [{ json: { isValid, challenge: challenge || '' } }];"
      },
      "id": "code-verify-challenge",
      "name": "Verify Challenge",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [440, 160]
    },
    {
      "parameters": {
        "conditions": {
          "options": {"caseSensitive": true, "leftValue": "", "typeValidation": "strict"},
          "conditions": [
            {"id":"c1","leftValue":"={{ $json.isValid }}","rightValue":true,"operator":{"type":"boolean","operation":"equals"}}
          ],
          "combinator": "and"
        },
        "options": {}
      },
      "id": "if-verification-valid",
      "name": "Verification Valid?",
      "type": "n8n-nodes-base.if",
      "typeVersion": 2.2,
      "position": [660, 160]
    },
    {
      "parameters": {
        "respondWith": "text",
        "responseBody": "={{ $json.challenge }}",
        "options": {"responseCode": 200}
      },
      "id": "respond-verify-success",
      "name": "Respond - Challenge Accepted",
      "type": "n8n-nodes-base.respondToWebhook",
      "typeVersion": 1.1,
      "position": [880, 80]
    },
    {
      "parameters": {
        "respondWith": "text",
        "responseBody": "Forbidden - token mismatch",
        "options": {"responseCode": 403}
      },
      "id": "respond-verify-fail",
      "name": "Respond - Forbidden",
      "type": "n8n-nodes-base.respondToWebhook",
      "typeVersion": 1.1,
      "position": [880, 240]
    },
    {
      "parameters": {
        "httpMethod": "POST",
        "path": "whatsapp-webhook",
        "responseMode": "onReceived",
        "options": {}
      },
      "id": "webhook-incoming-post",
      "name": "Webhook - Incoming Message (POST)",
      "type": "n8n-nodes-base.webhook",
      "typeVersion": 2,
      "position": [220, 460],
      "webhookId": "whatsapp-webhook-incoming"
    },
    {
      "parameters": {
        "jsCode": "const body = $input.first().json.body || {};\n\ntry {\n  const entry = body.entry && body.entry[0];\n  const change = entry && entry.changes && entry.changes[0];\n  const value = change && change.value;\n  const message = value && value.messages && value.messages[0];\n\n  if (!message) {\n    return [{ json: { hasMessage: false, raw: body } }];\n  }\n\n  const from = message.from;\n  const messageId = message.id;\n  const timestamp = message.timestamp;\n  const type = message.type;\n  const text = type === 'text' ? message.text.body : `[unsupported message type: ${type}]`;\n  const contactName = (value.contacts && value.contacts[0] && value.contacts[0].profile && value.contacts[0].profile.name) || 'Unknown';\n  const phoneNumberId = value.metadata && value.metadata.phone_number_id;\n\n  return [{ json: {\n    hasMessage: true,\n    from,\n    contactName,\n    messageId,\n    timestamp,\n    type,\n    text,\n    phoneNumberId\n  } }];\n} catch (e) {\n  return [{ json: { hasMessage: false, error: e.message, raw: body } }];\n}"
      },
      "id": "code-extract-message",
      "name": "Extract Message",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [440, 460]
    },
    {
      "parameters": {
        "conditions": {
          "options": {"caseSensitive": true, "leftValue": "", "typeValidation": "strict"},
          "conditions": [
            {"id":"c1","leftValue":"={{ $json.hasMessage }}","rightValue":true,"operator":{"type":"boolean","operation":"equals"}}
          ],
          "combinator": "and"
        },
        "options": {}
      },
      "id": "if-has-message",
      "name": "Has User Message?",
      "type": "n8n-nodes-base.if",
      "typeVersion": 2.2,
      "position": [660, 460]
    },
    {
      "parameters": {
        "assignments": {
          "assignments": [
            {"id":"1","name":"timestamp","type":"string","value":"={{ $now.toISO() }}"},
            {"id":"2","name":"from","type":"string","value":"={{ $json.from }}"},
            {"id":"3","name":"contact_name","type":"string","value":"={{ $json.contactName }}"},
            {"id":"4","name":"message_text","type":"string","value":"={{ $json.text }}"},
            {"id":"5","name":"message_id","type":"string","value":"={{ $json.messageId }}"},
            {"id":"6","name":"direction","type":"string","value":"inbound"}
          ]
        },
        "options": {}
      },
