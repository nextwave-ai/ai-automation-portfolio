{
  "name": "RAG - Query & Action Agent",
  "nodes": [
    {
      "parameters": {
        "httpMethod": "POST",
        "path": "rag-query",
        "responseMode": "responseNode",
        "options": {}
      },
      "id": "webhook-query",
      "name": "Webhook - Ask Question",
      "type": "n8n-nodes-base.webhook",
      "typeVersion": 2,
      "position": [240, 300],
      "webhookId": "rag-query-webhook"
    },
    {
      "parameters": {
        "method": "POST",
        "url": "https://api.openai.com/v1/embeddings",
        "authentication": "predefinedCredentialType",
        "nodeCredentialType": "openAiApi",
        "sendBody": true,
        "specifyBody": "json",
        "jsonBody": "={{ JSON.stringify({ model: \"text-embedding-3-small\", input: ($json.body ? $json.body.question : $json.question) }) }}",
        "options": {}
      },
      "id": "http-embed-question",
      "name": "Embed Question",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [460, 300]
    },
    {
      "parameters": {
        "operation": "read",
        "documentId": {"__rl": true, "value": "YOUR_SHEET_ID", "mode": "id"},
        "sheetName": {"__rl": true, "value": "KnowledgeBase", "mode": "name"},
        "options": {}
      },
      "id": "sheets-read-kb",
      "name": "Read Knowledge Base",
      "type": "n8n-nodes-base.googleSheets",
      "typeVersion": 4.5,
      "position": [680, 300]
    },
    {
      "parameters": {
        "jsCode": "const questionEmbedding = $('Embed Question').first().json.data[0].embedding;\nconst rawBody = $('Webhook - Ask Question').first().json.body || $('Webhook - Ask Question').first().json;\nconst question = rawBody.question;\n\nfunction cosineSimilarity(a, b) {\n  let dot = 0, normA = 0, normB = 0;\n  for (let i = 0; i < a.length; i++) {\n    dot += a[i] * b[i];\n    normA += a[i] * a[i];\n    normB += b[i] * b[i];\n  }\n  return dot / (Math.sqrt(normA) * Math.sqrt(normB));\n}\n\nconst rows = $input.all().map(item => item.json);\nconst scored = rows.map(row => {\n  let emb;\n  try { emb = JSON.parse(row.embedding); } catch (e) { emb = []; }\n  const score = emb.length ? cosineSimilarity(questionEmbedding, emb) : 0;\n  return { ...row, score };\n});\n\nscored.sort((a, b) => b.score - a.score);\nconst top = scored.slice(0, 3);\nconst topScore = top.length ? top[0].score : 0;\n\nconst context = top.map((r, i) => `[Source ${i + 1}: ${r.source}]\\n${r.chunk_text}`).join('\\n\\n');\nconst sources = top.map(r => r.source);\n\nreturn [{ json: { question, context, sources, topScore } }];"
      },
      "id": "code-semantic-search",
      "name": "Semantic Search",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [900, 300]
    },
    {
      "parameters": {
        "conditions": {
          "options": {"caseSensitive": true, "leftValue": "", "typeValidation": "strict"},
          "conditions": [
            {"id":"c1","leftValue":"={{ $json.topScore }}","rightValue":0.75,"operator":{"type":"number","operation":"gte"}}
          ],
          "combinator": "and"
        },
        "options": {}
      },
      "id": "if-confidence",
      "name": "Confidence Check",
      "type": "n8n-nodes-base.if",
      "typeVersion": 2.2,
      "position": [1120, 300]
    },
    {
      "parameters": {
        "method": "POST",
        "url": "https://api.openai.com/v1/chat/completions",
        "authentication": "predefinedCredentialType",
        "nodeCredentialType": "openAiApi",
        "sendBody": true,
        "specifyBody": "json",
        "jsonBody": "={{ JSON.stringify({ model: \"gpt-4o-mini\", messages: [ { role: \"system\", content: \"You are a business knowledge assistant. Answer the user's question using ONLY the provided context. If the user is asking to book a meeting or appointment, set intent to book_meeting and infer meeting_time as an ISO datetime in the near future if not specified. Otherwise set intent to answer. Respond ONLY with valid JSON, no markdown, no code fences: {\\\"intent\\\": \\\"answer or book_meeting\\\", \\\"answer\\\": \\\"text\\\", \\\"meeting_time\\\": \\\"ISO datetime or null\\\"}\" }, { role: \"user\", content: `Context:\\n${$json.context}\\n\\nQuestion: ${$json.question}` } ], temperature: 0.2 }) }}",
        "options": {}
      },
      "id": "http-generate-answer",
      "name": "Generate Answer",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [1340, 180]
    },
    {
      "parameters": {
        "jsCode": "let raw = $json.choices[0].message.content;\nraw = raw.replace(/```json|```/g, '').trim();\nlet parsed;\ntry {\n  parsed = JSON.parse(raw);\n} catch (e) {\n  parsed = { intent: 'answer', answer: raw, meeting_time: null };\n}\nif (!['answer', 'book_meeting'].includes(parsed.intent)) {\n  parsed.intent = 'answer';\n}\nreturn [{ json: {\n  intent: parsed.intent,\n  answer: parsed.answer || '',\n  meeting_time: parsed.meeting_time || null,\n  sources: $('Semantic Search').first().json.sources,\n  question: $('Semantic Search').first().json.question\n} }];"
      },
      "id": "code-parse-llm",
      "name": "Parse LLM Output",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [1560, 180]
    },
    {
      "parameters": {
        "conditions": {
          "options": {"caseSensitive": true, "leftValue": "", "typeValidation": "strict"},
          "conditions": [
            {"id":"c1","leftValue":"={{ $json.intent }}","rightValue":"book_meeting","operator":{"type":"string","operation":"equals"}}
          ],
          "combinator": "and"
        },
        "options": {}
      },
      "id": "if-intent-router",
      "name": "Intent Router",
      "type": "n8n-nodes-base.if",
      "typeVersion": 2.2,
      "position": [1780, 180]
    },
    {
      "parameters": {
        "operation": "create",
        "calendar": {"__rl": true, "value": "primary", "mode": "list"},
        "start": "={{ $json.meeting_time }}",
        "end": "={{ new Date(new Date($json.meeting_time).getTime() + 30*60000).toISOString() }}",
        "additionalFields": {
          "summary": "={{ 'Meeting booked via AI Agent - ' + $json.question }}"
        }
      },
      "id": "calendar-book",
      "name": "Book Meeting",
      "type": "n8n-nodes-base.googleCalendar",
      "typeVersion": 1.3,
      "position": [2000, 100]
    },
    {
      "parameters": {
        "assignments": {
          "assignments": [
            {"id":"1","name":"answer","type":"string","value":"={{ $('Parse LLM Output').item.json.answer }}"},
            {"id":"2","name":"sources","type":"array","value":"={{ $('Parse LLM Output').item.json.sources }}"},
            {"id":"3","name":"action_taken","type":"string","value":"={{ $('Parse LLM Output').item.json.intent === 'book_meeting' ? 'meeting_booked' : 'none' }}"}
          ]
        },
        "options": {}
      },
      "id": "set-format-response",
      "name": "Format Response",
      "type": "n8n-nodes-base.set",
      "typeVersion": 3.4,
      "position": [2220, 180]
    },
    {
      "parameters": {
        "respondWith": "json",
        "responseBody": "={{ $json }}",
        "options": {}
      },
      "id": "respond-query",
      "name": "Respond With Answer",
      "type": "n8n-nodes-base.respondToWebhook",
      "typeVersion": 1.1,
      "position": [2440, 180]
    },
    {
      "parameters": {
        "select": "channel",
        "channelId": {"__rl": true, "value": "YOUR_CHANNEL_ID", "mode": "id"},
        "text": "={{ 'Low-confidence question needs human review:\\nQ: ' + $json.question + '\\nTop match score: ' + $json.topScore }}",
        "otherOptions": {}
      },
      "id": "slack-escalate",
      "name": "Notify Human",
      "type": "n8n-nodes-base.slack",
      "typeVersion": 2.2,
      "position": [1340, 460]
    },
    {
      "parameters": {
        "respondWith": "json",
        "responseBody": "={{ { \"answer\": \"Thanks for your question - a team member will follow up shortly.\", \"sources\": [], \"action_taken\": \"escalated_to_human\" } }}",
        "options": {}
      },
      "id": "respond-escalate",
      "name": "Respond Escalated",
      "type": "n8n-nodes-base.respondToWebhook",
      "typeVersion": 1.1,
      "position": [1560, 460]
    }
  ],
